<Window
    x:Class="DingLater.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource DingPageBackgroundBrush}">
        <ContentControl
            x:Name="ContentHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <Image
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/DingLaterMark.svg" />
                    </Image.Source>
                </Image>
                <ProgressRing
                    Width="24"
                    Height="24"
                    IsActive="True" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource DingSecondaryTextStyle}"
                    Text="正在启动 DingLater…"
                    TextAlignment="Center" />
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>
