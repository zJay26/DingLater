<Page
    x:Class="DingLater.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="PromiseIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource DingAccentSoftBrush}" />
        </Style>
        <Style x:Key="PromiseIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource DingAccentTextBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="720"
            Padding="32,40"
            HorizontalAlignment="Center">
            <StackPanel Spacing="24">
                <StackPanel Spacing="14">
                    <Image
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        AutomationProperties.AccessibilityView="Raw">
                        <Image.Source>
                            <SvgImageSource UriSource="ms-appx:///Assets/DingLaterMark.svg" />
                        </Image.Source>
                    </Image>
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource DingPageTitleStyle}"
                            Text="开始使用 DingLater" />
                        <TextBlock Style="{StaticResource DingBodyTextStyle}" Text="把需要回复的钉钉消息先收好，在合适的时候再处理。" />
                    </StackPanel>
                </StackPanel>

                <Border Padding="20" Style="{StaticResource DingSurfaceBorderStyle}">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PromiseIconBorderStyle}">
                                <FontIcon Glyph="&#xE72E;" Style="{StaticResource PromiseIconStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource DingBodyStrongTextStyle}" Text="只读访问" />
                                <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="只读解析当前用户的钉钉本地数据库；不会打开聊天、写回已读状态或连接钉钉服务器。" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PromiseIconBorderStyle}">
                                <FontIcon Glyph="&#xEA18;" Style="{StaticResource PromiseIconStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource DingBodyStrongTextStyle}" Text="本地加密保存" />
                                <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="数据库密钥只在内存中使用；DingLater 保存的正文逐条加密，并按留存期自动清理。" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PromiseIconBorderStyle}">
                                <FontIcon Glyph="&#xE823;" Style="{StaticResource PromiseIconStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource DingBodyStrongTextStyle}" Text="只收拢之后的新消息" />
                                <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="首次启用不会导入历史消息，从此刻开始记录。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12">
                    <CheckBox
                        x:Name="ConsentCheckBox"
                        Checked="ConsentCheckBox_Changed"
                        Content="允许 DingLater 只读访问并解析本机钉钉数据库"
                        FontFamily="{StaticResource DingTextFontFamily}"
                        FontSize="{ThemeResource DingBodyFontSize}"
                        Unchecked="ConsentCheckBox_Changed" />
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        FontFamily="{StaticResource DingTextFontFamily}"
                        FontSize="{ThemeResource DingBodyFontSize}"
                        Header="随 Windows 登录启动"
                        IsOn="True" />
                </StackPanel>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="False" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="ExitButton_Click"
                        Content="退出"
                        Style="{StaticResource DingQuietButtonStyle}" />
                    <Button
                        x:Name="ContinueButton"
                        Click="ContinueButton_Click"
                        Content="开始使用"
                        IsEnabled="False"
                        Style="{StaticResource DingPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
