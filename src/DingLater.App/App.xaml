<Application
    x:Class="DingLater.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DingPageBackgroundBrush" Color="#F3F5F9" />
                    <SolidColorBrush x:Key="DingSurfaceBrush" Color="#FCFCFD" />
                    <SolidColorBrush x:Key="DingSurfaceRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DingTextBrush" Color="#1F2633" />
                    <SolidColorBrush x:Key="DingSecondaryTextBrush" Color="#657184" />
                    <SolidColorBrush x:Key="DingAccentBrush" Color="#5B68BC" />
                    <SolidColorBrush x:Key="DingAccentForegroundBrush" Color="White" />
                    <SolidColorBrush x:Key="DingAccentSoftBrush" Color="#E9EBF8" />
                    <SolidColorBrush x:Key="DingSuccessBrush" Color="#3B7A63" />
                    <SolidColorBrush x:Key="DingDividerBrush" Color="#DDE2EA" />
                    <SolidColorBrush x:Key="DingDangerBrush" Color="#A33D4F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DingPageBackgroundBrush" Color="#17191E" />
                    <SolidColorBrush x:Key="DingSurfaceBrush" Color="#20232A" />
                    <SolidColorBrush x:Key="DingSurfaceRaisedBrush" Color="#282C34" />
                    <SolidColorBrush x:Key="DingTextBrush" Color="#F2F4F8" />
                    <SolidColorBrush x:Key="DingSecondaryTextBrush" Color="#AAB2C1" />
                    <SolidColorBrush x:Key="DingAccentBrush" Color="#AEB7FF" />
                    <SolidColorBrush x:Key="DingAccentForegroundBrush" Color="Black" />
                    <SolidColorBrush x:Key="DingAccentSoftBrush" Color="#30364F" />
                    <SolidColorBrush x:Key="DingSuccessBrush" Color="#83C5A7" />
                    <SolidColorBrush x:Key="DingDividerBrush" Color="#3A3F48" />
                    <SolidColorBrush x:Key="DingDangerBrush" Color="#FF9AA9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DingPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DingSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DingSurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DingTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DingSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DingAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DingAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DingAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DingSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DingDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DingDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Typography.Standard.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DingSurfaceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DingSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource DingDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="DingQuietButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
                <Setter Property="MinHeight" Value="{ThemeResource DingControlHeight}" />
                <Setter Property="Padding" Value="{ThemeResource DingControlPadding}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="DingPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
                <Setter Property="MinHeight" Value="{ThemeResource DingControlHeight}" />
                <Setter Property="Padding" Value="{ThemeResource DingControlPadding}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
