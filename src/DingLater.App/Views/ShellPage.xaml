<Page
    x:Class="DingLater.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView
        x:Name="Navigation"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1008"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        FontFamily="Segoe UI Variable Text"
        FontSize="{ThemeResource DingBodyFontSize}"
        OpenPaneLength="190"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="InboxItem" Content="收件箱" Tag="Inbox">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE715;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{Binding InboxCount}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SnoozedItem" Content="稍后" Tag="Snoozed">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE823;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{Binding SnoozedCount}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HandledItem" Content="已处理" Tag="Handled">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE73E;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.InfoBadge>
                    <InfoBadge Value="{Binding HandledCount}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Margin="8" Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource DingSuccessBrush}"
                    Glyph="&#xEA3A;" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DingSecondaryTextStyle}"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </NavigationView.PaneFooter>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="ErrorInfoBar"
                Margin="12,8,12,0"
                IsOpen="False"
                Severity="Error" />
            <ContentControl x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Page>
