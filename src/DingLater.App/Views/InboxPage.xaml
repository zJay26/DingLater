<Page
    x:Class="DingLater.App.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DingLater.App.Views"
    xmlns:vm="using:DingLater.App.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid" Padding="{StaticResource DingPagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource DingPageTitleStyle}" Text="{Binding SectionTitle}" />
            <Button
                x:Name="BulkActionButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="批量操作"
                Click="BulkActionButton_Click"
                Style="{StaticResource DingQuietButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon x:Name="BulkActionIcon" FontSize="15" />
                    <TextBlock x:Name="BulkActionLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                MaxWidth="380"
                MinWidth="180"
                HorizontalAlignment="Right"
                AutomationProperties.Name="搜索消息"
                FontFamily="Segoe UI Variable Text"
                FontSize="{ThemeResource DingBodyFontSize}"
                PlaceholderText="搜索对象、发送者或正文"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Grid x:Name="PaneGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ConversationColumn" Width="340" />
                <ColumnDefinition x:Name="DividerColumn" Width="1" />
                <ColumnDefinition x:Name="DetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="ConversationPane"
                Grid.Column="0"
                Background="{ThemeResource DingSurfaceBrush}"
                BorderBrush="{ThemeResource DingDividerBrush}"
                BorderThickness="1"
                CornerRadius="8,0,0,8">
                <Grid>
                    <ListView
                        x:Name="ConversationList"
                        AutomationProperties.Name="会话列表"
                        ItemsSource="{Binding Conversations}"
                        SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                        SelectionChanged="ConversationList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="76" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConversationThreadViewModel">
                                <Grid Padding="16,13" ColumnSpacing="10" RowSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        MaxLines="1"
                                        Style="{StaticResource DingConversationTitleStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource DingSecondaryTextStyle}"
                                        Text="{x:Bind LatestAtText}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        MaxLines="2"
                                        Style="{StaticResource DingSecondaryTextStyle}"
                                        Text="{x:Bind Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource DingSecondaryTextStyle}"
                                        Text="{x:Bind CountText}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Foreground="{ThemeResource DingAccentBrush}"
                                        Style="{StaticResource DingSecondaryTextStyle}"
                                        Text="{x:Bind ReminderText}"
                                        Visibility="{x:Bind local:InboxPage.BoolToVisibility(HasReminder)}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                x:Name="PaneDivider"
                Grid.Column="1"
                Background="{ThemeResource DingDividerBrush}" />

            <Border
                x:Name="DetailPane"
                Grid.Column="2"
                Background="{ThemeResource DingSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource DingDividerBrush}"
                BorderThickness="0,1,1,1"
                CornerRadius="0,8,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="DetailHeader" Padding="18,14" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BackButton"
                            Click="BackButton_Click"
                            Style="{StaticResource DingQuietButtonStyle}"
                            ToolTipService.ToolTip="返回会话列表"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            Grid.Column="1"
                            MaxLines="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DingConversationTitleStyle}"
                            Text="{Binding SelectedConversation.Title}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ListView
                        x:Name="MessageList"
                        Grid.Row="1"
                        AutomationProperties.Name="当前会话消息"
                        ItemsSource="{Binding SelectedConversation.Messages}"
                        SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                        SelectionChanged="MessageList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="70" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MessageCardViewModel">
                                <Border
                                    Padding="18,8"
                                    BorderBrush="{ThemeResource DingDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid RowSpacing="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                MaxLines="1"
                                                Style="{StaticResource DingConversationTitleStyle}"
                                                Text="{x:Bind Sender}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DingSecondaryTextStyle}"
                                                Text="{x:Bind CapturedAtText}" />
                                            <Button
                                                Grid.Column="2"
                                                Width="40"
                                                Height="40"
                                                MinWidth="40"
                                                MinHeight="40"
                                                Padding="0"
                                                AutomationProperties.Name="消息信息"
                                                Click="MessageInfoButton_Click"
                                                DataContext="{x:Bind}"
                                                Style="{StaticResource DingQuietButtonStyle}"
                                                ToolTipService.ToolTip="消息信息">
                                                <FontIcon Glyph="&#xE712;" />
                                            </Button>
                                        </Grid>
                                        <Border
                                            Grid.Row="1"
                                            Margin="0,2,0,1"
                                            Padding="9,5"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="{x:Bind SnoozedUntilText}"
                                            Background="{ThemeResource DingAccentSoftBrush}"
                                            BorderBrush="{ThemeResource DingAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{x:Bind local:InboxPage.BoolToVisibility(HasSnoozedReminder)}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    FontSize="14"
                                                    Foreground="{ThemeResource DingAccentBrush}"
                                                    Glyph="&#xE823;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource DingAccentBrush}"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource DingBodyTextStyle}"
                                                    Text="{x:Bind SnoozedUntilText}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Grid.Row="2"
                                            Style="{StaticResource DingBodyTextStyle}"
                                            Text="{x:Bind Body}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        x:Name="ActionBar"
                        Grid.Row="2"
                        Padding="14"
                        Background="{ThemeResource DingAccentSoftBrush}"
                        BorderBrush="{ThemeResource DingDividerBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid
                                x:Name="SnoozeActions"
                                HorizontalAlignment="Left"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <SplitButton
                                    x:Name="QuickSnoozeButton"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="{ThemeResource DingBodyFontSize}"
                                    MinHeight="{StaticResource DingControlHeight}">
                                    <SplitButton.Flyout>
                                        <Flyout>
                                            <StackPanel Width="280" Spacing="10">
                                                <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="稍后多久" />
                                                <Grid ColumnSpacing="8" RowSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Button x:Name="Preset10Button" Click="PresetSnoozeButton_Click" Content="10 分钟" Style="{StaticResource DingQuietButtonStyle}" Tag="10" />
                                                    <Button x:Name="Preset15Button" Grid.Column="1" Click="PresetSnoozeButton_Click" Content="15 分钟" Style="{StaticResource DingQuietButtonStyle}" Tag="15" />
                                                    <Button x:Name="Preset30Button" Grid.Row="1" Click="PresetSnoozeButton_Click" Content="30 分钟" Style="{StaticResource DingQuietButtonStyle}" Tag="30" />
                                                    <Button x:Name="Preset60Button" Grid.Row="1" Grid.Column="1" Click="PresetSnoozeButton_Click" Content="60 分钟" Style="{StaticResource DingQuietButtonStyle}" Tag="60" />
                                                </Grid>
                                                <NumberBox
                                                    x:Name="QuickMinutesBox"
                                                    Header="其他分钟数"
                                                    FontFamily="Segoe UI Variable Text"
                                                    FontSize="{ThemeResource DingBodyFontSize}"
                                                    Maximum="1440"
                                                    Minimum="1"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    ValueChanged="QuickMinutesBox_ValueChanged" />
                                                <Button
                                                    x:Name="UseQuickMinutesButton"
                                                    HorizontalAlignment="Stretch"
                                                    Click="UseQuickMinutesButton_Click"
                                                    Content="按这个时长稍后"
                                                    Style="{StaticResource DingPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </Flyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                                <Button
                                    x:Name="TomorrowButton"
                                    Grid.Column="1"
                                    Click="TomorrowButton_Click"
                                    Content="明早 9:00"
                                    Style="{StaticResource DingQuietButtonStyle}" />
                                <Button
                                    x:Name="ExactTimeButton"
                                    Grid.Column="2"
                                    Click="ExactTimeButton_Click"
                                    Content="选择日期时间…"
                                    Style="{StaticResource DingQuietButtonStyle}" />
                                <Button
                                    x:Name="HandledButton"
                                    Grid.Column="3"
                                    Click="HandledButton_Click"
                                    Content="已处理"
                                    Style="{StaticResource DingPrimaryButtonStyle}" />
                            </Grid>
                            <StackPanel
                                x:Name="HandledActions"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="RestoreButton"
                                    Click="RestoreButton_Click"
                                    Content="回到待处理"
                                    Style="{StaticResource DingPrimaryButtonStyle}" />
                                <Button
                                    x:Name="DeleteButton"
                                    Click="DeleteButton_Click"
                                    Content="删除消息"
                                    Foreground="{ThemeResource DingDangerBrush}"
                                    Style="{StaticResource DingQuietButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border
                x:Name="UnifiedEmptyState"
                Grid.ColumnSpan="3"
                Background="{ThemeResource DingSurfaceRaisedBrush}"
                BorderBrush="{ThemeResource DingDividerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <Border
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource DingAccentSoftBrush}"
                        CornerRadius="29">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="26"
                            Foreground="{ThemeResource DingAccentBrush}"
                            Glyph="&#xE8F4;" />
                    </Border>
                    <TextBlock
                        x:Name="EmptyTitle"
                        Style="{StaticResource DingConversationTitleStyle}"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="EmptyDescription"
                        Style="{StaticResource DingSecondaryTextStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ClearSearchButton"
                        HorizontalAlignment="Center"
                        Click="ClearSearchButton_Click"
                        Content="清除搜索"
                        Style="{StaticResource DingQuietButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
