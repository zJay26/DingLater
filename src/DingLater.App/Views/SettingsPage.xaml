<Page
    x:Class="DingLater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DingLater.App.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Page.Resources>
        <Style TargetType="controls:SettingsCard">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="controls:SettingsExpander">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>
    <ScrollViewer
        x:Name="SettingsScroller"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="SettingsContent"
            MaxWidth="960"
            Padding="{StaticResource DingPagePadding}"
            HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="14">
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource DingPageTitleStyle}" Text="设置" />
                    <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="更改会立即保存" />
                </StackPanel>

                <controls:SettingsExpander x:Name="UpdatesExpander" Header="软件更新" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="自动检查更新" Description="运行期间每 6 小时检查 GitHub 正式版本；不会自动下载或重启。">
                            <ToggleSwitch x:Name="AutoUpdateToggle" AutomationProperties.Name="每 6 小时自动检查更新" Toggled="AutoUpdateToggle_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="更新下载目录" ContentAlignment="Vertical">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DownloadDirectoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource DingSecondaryTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChooseDownloadDirectoryButton" Content="选择文件夹…" Click="ChooseDownloadDirectoryButton_Click" />
                                    <Button x:Name="ResetDownloadDirectoryButton" Content="恢复默认" Click="ResetDownloadDirectoryButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="版本与更新" ContentAlignment="Vertical">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="CurrentVersionText" Style="{StaticResource DingBodyTextStyle}" />
                                <TextBlock x:Name="LastUpdateCheckText" Style="{StaticResource DingSecondaryTextStyle}" />
                                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource DingBodyTextStyle}" AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="更新下载进度" />
                                <StackPanel Spacing="8">
                                    <Button x:Name="CheckUpdateButton" Content="立即检查" Click="CheckUpdateButton_Click" />
                                    <HyperlinkButton x:Name="ReleaseNotesLink" Content="查看版本说明" Visibility="Collapsed" />
                                    <Button x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdateButton_Click" Visibility="Collapsed" Style="{StaticResource DingPrimaryButtonStyle}" />
                                    <Button x:Name="InstallUpdateButton" Content="重启并更新…" Click="InstallUpdateButton_Click" Visibility="Collapsed" Style="{StaticResource DingPrimaryButtonStyle}" />
                                    <Button x:Name="CancelUpdateButton" Content="取消下载" Click="CancelUpdateButton_Click" Visibility="Collapsed" />
                                    <Button x:Name="SkipUpdateButton" Content="跳过此版本" Click="SkipUpdateButton_Click" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="窗口置顶" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE718;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="启用窗口置顶" Description="按 Ctrl + Win + T 置顶当前窗口，再按一次取消。置顶窗口显示描边，不播放音效。">
                            <ToggleSwitch x:Name="AlwaysOnTopToggle" AutomationProperties.Name="启用窗口置顶" Toggled="AlwaysOnTopToggle_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="退出时取消置顶" Description="正常退出 DingLater 时，取消本次由它设置的置顶。关闭功能开关会立即取消这些置顶。">
                            <ToggleSwitch x:Name="RestoreTopmostToggle" AutomationProperties.Name="退出时取消置顶" Toggled="RestoreTopmostToggle_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="快捷键状态" ContentAlignment="Vertical">
                            <InfoBar x:Name="TopmostInfoBar" IsOpen="True" IsClosable="False" Severity="Informational" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="外观" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Header="界面字号"
                            Description="同时调整文字、行高与控件间距。">
                            <ComboBox
                                x:Name="FontScaleComboBox"
                                MinWidth="180"
                                AutomationProperties.Name="界面字号"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="{ThemeResource DingBodyFontSize}"
                                SelectionChanged="FontScaleComboBox_SelectionChanged" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Header="消息捕获"
                    Description="决定哪些群聊消息进入待处理"
                    IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Header="群聊收取范围"
                            Description="“仅提到我”包含 @我 和 @所有人。">
                            <ToggleSwitch
                                x:Name="GroupMessagesToggle"
                                AutomationProperties.Name="捕获所有群聊消息"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="{ThemeResource DingBodyFontSize}"
                                OffContent="仅提到我"
                                OnContent="全部消息"
                                Toggled="GroupMessagesToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="提醒与启动" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7ED;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Header="通知显示消息预览"
                            Description="开启后，锁屏通知可能显示发送者和正文。">
                            <ToggleSwitch
                                x:Name="ReminderPreviewToggle"
                                AutomationProperties.Name="通知显示消息预览"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="{ThemeResource DingBodyFontSize}"
                                Toggled="ReminderPreviewToggle_Toggled" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="随 Windows 登录启动"
                            Description="登录后在后台开始捕获，不主动弹出窗口。">
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                AutomationProperties.Name="随 Windows 登录启动"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="{ThemeResource DingBodyFontSize}"
                                Toggled="StartupToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="存储与隐私" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            Header="消息留存天数"
                            Description="到期后自动删除本地消息并取消对应提醒。">
                            <NumberBox
                                x:Name="RetentionNumberBox"
                                Width="160"
                                AutomationProperties.Name="消息留存天数"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="{ThemeResource DingBodyFontSize}"
                                Maximum="365"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="RetentionNumberBox_ValueChanged" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="删除全部本地消息"
                            Description="永久删除消息、处理状态和稍后提醒，不影响钉钉。">
                            <Button
                                Click="DeleteAllButton_Click"
                                Content="删除全部…"
                                Foreground="{ThemeResource DingDangerBrush}"
                                Style="{StaticResource DingQuietButtonStyle}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander
                    Header="诊断"
                    Description="用于排查捕获来源，不包含消息内容"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="捕获来源">
                            <ItemsControl ItemsSource="{Binding HealthSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureHealthViewModel">
                                        <StackPanel Margin="0,3" Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource DingBodyTextStyle}" Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="{x:Bind State}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Header="诊断信息"
                            Description="复制运行状态与错误代码。">
                            <Button
                                Click="CopyDiagnosticsButton_Click"
                                Content="复制"
                                Style="{StaticResource DingQuietButtonStyle}" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <InfoBar
                    x:Name="CopyInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Message="诊断信息已复制，不含消息内容。"
                    Severity="Success" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
