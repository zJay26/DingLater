<Page
    x:Class="DingLater.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DingLater.App.ViewModels">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Number1" Invoked="SectionAccelerator_Invoked" Modifiers="Control" />
        <KeyboardAccelerator Key="Number2" Invoked="SectionAccelerator_Invoked" Modifiers="Control" />
        <KeyboardAccelerator Key="Number3" Invoked="SectionAccelerator_Invoked" Modifiers="Control" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CaptureStates">
                <VisualState x:Name="CapturePreparing" />
                <VisualState x:Name="CaptureCapturing">
                    <VisualState.Setters>
                        <Setter Target="CaptureStatusDot.Fill" Value="{ThemeResource DingSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CaptureWaiting">
                    <VisualState.Setters>
                        <Setter Target="CaptureStatusDot.Fill" Value="{ThemeResource DingSecondaryTextBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CapturePaused">
                    <VisualState.Setters>
                        <Setter Target="CaptureStatusDot.Fill" Value="{ThemeResource DingWarningBrush}" />
                        <Setter Target="CaptureToggleButton.Style" Value="{StaticResource DingPrimaryButtonStyle}" />
                        <Setter Target="CaptureToggleIcon.Glyph" Value="&#xE768;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <NavigationView
            x:Name="Navigation"
            AlwaysShowHeader="False"
            FontFamily="{StaticResource DingTextFontFamily}"
            FontSize="{ThemeResource DingBodyFontSize}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Top"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="InboxItem"
                    AutomationProperties.Name="待处理"
                    Content="待处理"
                    Tag="Inbox"
                    ToolTipService.ToolTip="待处理（Ctrl+1）">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="InboxBadge" Value="{Binding InboxCount}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SnoozedItem"
                    AutomationProperties.Name="稍后提醒"
                    Tag="Snoozed"
                    ToolTipService.ToolTip="稍后提醒（Ctrl+2）">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="稍后提醒" />
                            <TextBlock
                                x:Name="SnoozedCountText"
                                VerticalAlignment="Center"
                                Style="{StaticResource DingSecondaryTextStyle}"
                                Text="{Binding SnoozedCount}" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HandledItem"
                    AutomationProperties.Name="已处理"
                    Tag="Handled"
                    ToolTipService.ToolTip="已处理（Ctrl+3）">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="已处理" />
                            <TextBlock
                                x:Name="HandledCountText"
                                VerticalAlignment="Center"
                                Style="{StaticResource DingSecondaryTextStyle}"
                                Text="{Binding HandledCount}" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Button
                    x:Name="CaptureStatusButton"
                    Margin="0,0,4,0"
                    Padding="10,4"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="消息捕获状态"
                    Style="{StaticResource DingSubtleButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="CaptureStatusDot"
                            Fill="{ThemeResource DingSecondaryTextBrush}"
                            Style="{StaticResource DingStatusDotStyle}" />
                        <TextBlock
                            x:Name="CaptureStatusText"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource DingTextBrush}"
                            Style="{StaticResource DingSecondaryTextStyle}"
                            Text="正在准备捕获…"
                            TextWrapping="NoWrap" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource DingSecondaryTextBrush}"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="CaptureFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource DingBodyStrongTextStyle}"
                                        Text="消息捕获" />
                                    <TextBlock x:Name="CaptureDetailText" Style="{StaticResource DingSecondaryTextStyle}" />
                                </StackPanel>
                                <ItemsControl x:Name="HealthList" ItemsSource="{x:Bind ViewModel.HealthSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CaptureHealthViewModel">
                                            <Grid Margin="0,2" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Foreground="{ThemeResource DingTextBrush}"
                                                    Style="{StaticResource DingSecondaryTextStyle}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource DingSecondaryTextStyle}"
                                                    Text="{x:Bind State}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    x:Name="CaptureToggleButton"
                                    HorizontalAlignment="Stretch"
                                    Click="CaptureToggleButton_Click"
                                    Style="{StaticResource DingQuietButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            x:Name="CaptureToggleIcon"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Glyph="&#xE769;" />
                                        <TextBlock x:Name="CaptureToggleLabel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="BannerHost">
                    <InfoBar
                        x:Name="ErrorInfoBar"
                        Margin="0,12,0,0"
                        Closed="Banner_Closed"
                        IsOpen="False"
                        Severity="Error"
                        Title="操作未完成"
                        Visibility="Collapsed" />
                    <InfoBar
                        x:Name="PausedInfoBar"
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="False"
                        Message="新消息不会进入待处理；已保存的消息和稍后提醒不受影响。"
                        Severity="Warning"
                        Title="捕获已暂停"
                        Visibility="Collapsed">
                        <InfoBar.ActionButton>
                            <Button Click="CaptureToggleButton_Click" Content="开始捕获" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="UpdateInfoBar"
                        Margin="0,12,0,0"
                        Closed="UpdateInfoBar_Closed"
                        IsClosable="True"
                        IsOpen="False"
                        Message="可在设置中选择下载更新，也可以继续使用当前版本。"
                        Severity="Informational"
                        Visibility="Collapsed">
                        <InfoBar.ActionButton>
                            <Button Click="ViewUpdateButton_Click" Content="查看更新" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <ContentControl
                    x:Name="PageHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False">
                    <ContentControl.ContentTransitions>
                        <TransitionCollection>
                            <ContentThemeTransition />
                        </TransitionCollection>
                    </ContentControl.ContentTransitions>
                </ContentControl>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
