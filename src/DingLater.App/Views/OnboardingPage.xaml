<Page
    x:Class="DingLater.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="760" Padding="32" HorizontalAlignment="Center">
            <StackPanel Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border
                        Width="46"
                        Height="46"
                        Background="{ThemeResource DingAccentBrush}"
                        CornerRadius="10">
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="22"
                            Foreground="White"
                            Glyph="&#xE823;" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DingPageTitleStyle}"
                        Text="开始使用 DingLater" />
                </StackPanel>

                <TextBlock
                    Style="{StaticResource DingBodyTextStyle}"
                    Text="DingLater 只读访问当前用户的钉钉本地数据库，收拢启用之后的新消息。它不会打开聊天、写回已读状态或连接钉钉服务器。" />

                <Border
                    Padding="18"
                    Background="{ThemeResource DingSurfaceBrush}"
                    BorderBrush="{ThemeResource DingDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="本地与只读" />
                        <TextBlock
                            Style="{StaticResource DingSecondaryTextStyle}"
                            Text="数据库密钥只在内存中使用；DingLater 保存的正文逐条加密，并按留存期自动清理。首次启用不会导入历史消息。" />
                    </StackPanel>
                </Border>

                <CheckBox
                    x:Name="ConsentCheckBox"
                    Checked="ConsentCheckBox_Changed"
                    Content="允许 DingLater 只读访问并解析本机钉钉数据库"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="{ThemeResource DingBodyFontSize}"
                    Unchecked="ConsentCheckBox_Changed" />

                <ToggleSwitch
                    x:Name="StartupToggle"
                    Header="随 Windows 登录启动"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="{ThemeResource DingBodyFontSize}"
                    IsOn="True" />

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="False" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button
                        Click="ExitButton_Click"
                        Content="退出"
                        Style="{StaticResource DingQuietButtonStyle}" />
                    <Button
                        x:Name="ContinueButton"
                        Click="ContinueButton_Click"
                        Content="开始使用"
                        IsEnabled="False"
                        Style="{StaticResource DingPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
