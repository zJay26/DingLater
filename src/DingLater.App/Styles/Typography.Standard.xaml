<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="DingBodyFontSize">16</x:Double>
    <x:Double x:Key="DingSecondaryFontSize">13</x:Double>
    <x:Double x:Key="DingConversationFontSize">17</x:Double>
    <x:Double x:Key="DingPageTitleFontSize">28</x:Double>
    <x:Double x:Key="DingBodyLineHeight">24</x:Double>
    <x:Double x:Key="DingControlHeight">38</x:Double>
    <Thickness x:Key="DingControlPadding">14,7</Thickness>
    <Thickness x:Key="DingPagePadding">24</Thickness>
    <x:Double x:Key="DingSpacing">12</x:Double>
    <Style x:Key="DingBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource DingBodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource DingBodyLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource DingTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DingSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DingSecondaryFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource DingSecondaryTextBrush}" />
    </Style>
    <Style x:Key="DingConversationTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DingConversationFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DingPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource DingPageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
