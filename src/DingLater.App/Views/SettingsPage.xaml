<Page
    x:Class="DingLater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DingLater.App.ViewModels">
    <Page.Resources>
        <Style TargetType="controls:SettingsCard">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
        </Style>
        <Style TargetType="controls:SettingsExpander">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="900" Padding="{StaticResource DingPagePadding}" HorizontalAlignment="Center">
            <StackPanel Spacing="20">
                <TextBlock Style="{StaticResource DingPageTitleStyle}" Text="设置" />

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="外观" />
                    <controls:SettingsCard Header="字号">
                        <ComboBox
                            x:Name="FontScaleComboBox"
                            MinWidth="180"
                            AutomationProperties.Name="界面字号"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{ThemeResource DingBodyFontSize}"
                            SelectionChanged="FontScaleComboBox_SelectionChanged" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="捕获" />
                    <controls:SettingsCard Header="群聊消息">
                        <ToggleSwitch
                            x:Name="GroupMessagesToggle"
                            AutomationProperties.Name="捕获所有群聊消息"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{ThemeResource DingBodyFontSize}"
                            OffContent="仅提到我"
                            OnContent="全部"
                            Toggled="GroupMessagesToggle_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="捕获状态">
                        <Button
                            x:Name="CaptureButton"
                            Click="CaptureButton_Click"
                            Style="{StaticResource DingQuietButtonStyle}" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="提醒与启动" />
                    <controls:SettingsCard
                        Header="通知预览"
                        Description="启用后，锁屏通知可能显示发送者和正文。">
                        <ToggleSwitch
                            x:Name="ReminderPreviewToggle"
                            AutomationProperties.Name="通知显示消息预览"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{ThemeResource DingBodyFontSize}"
                            Toggled="ReminderPreviewToggle_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="随 Windows 登录启动">
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            AutomationProperties.Name="随 Windows 登录启动"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{ThemeResource DingBodyFontSize}"
                            Toggled="StartupToggle_Toggled" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="存储与隐私" />
                    <controls:SettingsCard Header="消息留存">
                        <NumberBox
                            x:Name="RetentionNumberBox"
                            Width="160"
                            AutomationProperties.Name="消息留存天数"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="{ThemeResource DingBodyFontSize}"
                            Maximum="365"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="RetentionNumberBox_ValueChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="删除全部本地消息"
                        Description="永久删除消息、处理状态和稍后提醒，不影响钉钉。">
                        <Button
                            Click="DeleteAllButton_Click"
                            Content="删除…"
                            Foreground="{ThemeResource DingDangerBrush}"
                            Style="{StaticResource DingQuietButtonStyle}" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DingConversationTitleStyle}" Text="诊断" />
                    <controls:SettingsExpander Header="捕获状态" IsExpanded="False">
                        <controls:SettingsExpander.Content>
                            <TextBlock
                                Style="{StaticResource DingSecondaryTextStyle}"
                                Text="{Binding StatusText}" />
                        </controls:SettingsExpander.Content>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="来源">
                                <ItemsControl ItemsSource="{Binding HealthSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CaptureHealthViewModel">
                                            <StackPanel Margin="0,3" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource DingBodyTextStyle}" Text="{x:Bind Name}" />
                                                <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="{x:Bind State}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="诊断信息">
                                <Button
                                    Click="CopyDiagnosticsButton_Click"
                                    Content="复制"
                                    Style="{StaticResource DingQuietButtonStyle}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                    <InfoBar
                        x:Name="CopyInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Message="诊断信息已复制，不含消息内容。"
                        Severity="Success" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
