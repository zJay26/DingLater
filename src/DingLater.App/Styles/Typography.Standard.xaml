<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep the four Typography.*.xaml scales structurally identical; only the numbers differ. -->
    <x:Double x:Key="DingBodyFontSize">16</x:Double>
    <x:Double x:Key="DingSecondaryFontSize">13</x:Double>
    <x:Double x:Key="DingCaptionFontSize">12</x:Double>
    <x:Double x:Key="DingConversationFontSize">17</x:Double>
    <x:Double x:Key="DingSubtitleFontSize">20</x:Double>
    <x:Double x:Key="DingPageTitleFontSize">28</x:Double>
    <x:Double x:Key="DingBodyLineHeight">24</x:Double>
    <x:Double x:Key="DingSecondaryLineHeight">20</x:Double>
    <x:Double x:Key="DingControlHeight">38</x:Double>
    <Thickness x:Key="DingControlPadding">14,7</Thickness>
    <Thickness x:Key="DingPagePadding">24</Thickness>
    <x:Double x:Key="DingSpacing">12</x:Double>
    <x:Double x:Key="DingAvatarSize">38</x:Double>
    <CornerRadius x:Key="DingAvatarCornerRadius">19</CornerRadius>
    <x:Double x:Key="DingAvatarFontSize">16</x:Double>
    <x:Double x:Key="DingIconButtonSize">34</x:Double>
    <!-- CommunityToolkit SettingsCard reads this key; scaling it keeps descriptions in step with headers. -->
    <x:Double x:Key="SettingsCardDescriptionFontSize">13</x:Double>
    <Style x:Key="DingBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="{StaticResource DingBodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource DingBodyLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource DingTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DingBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DingSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DingSecondaryFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource DingSecondaryLineHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource DingSecondaryTextBrush}" />
    </Style>
    <Style x:Key="DingCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DingSecondaryTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DingCaptionFontSize}" />
        <Setter Property="LineHeight" Value="0" />
    </Style>
    <Style x:Key="DingConversationTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource DingConversationFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DingSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource DingSubtitleFontSize}" />
        <Setter Property="LineHeight" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DingPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyTextStyle}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="{StaticResource DingPageTitleFontSize}" />
        <Setter Property="LineHeight" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DingSettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DingBodyStrongTextStyle}">
        <Setter Property="Margin" Value="1,24,0,6" />
    </Style>
</ResourceDictionary>
