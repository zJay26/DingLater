<Page
    x:Class="DingLater.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:DingLater.App.ViewModels"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Page.Resources>
        <Style TargetType="controls:SettingsCard">
            <Setter Property="FontFamily" Value="{StaticResource DingTextFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="controls:SettingsExpander">
            <Setter Property="FontFamily" Value="{StaticResource DingTextFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="FontFamily" Value="{StaticResource DingTextFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource DingTextFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource DingBodyFontSize}" />
            <Setter Property="MinWidth" Value="200" />
        </Style>
    </Page.Resources>
    <ScrollViewer
        x:Name="SettingsScroller"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="SettingsContent"
            MaxWidth="960"
            Padding="{StaticResource DingPagePadding}"
            HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="4">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource DingPageTitleStyle}"
                    Text="设置" />
                <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="更改会立即保存。" />

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="消息捕获" />
                <controls:SettingsCard Header="群聊收取范围" Description="私聊消息始终收取；“仅 @我”同时包含 @我 和 @所有人。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="GroupCaptureModeComboBox"
                        AutomationProperties.Name="群聊收取范围"
                        SelectionChanged="GroupCaptureModeComboBox_SelectionChanged" />
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="通知与启动" />
                <controls:SettingsCard Header="通知显示消息预览" Description="开启后，提醒通知和托盘列表会显示发送者与正文，锁屏上也可能可见。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE890;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="ReminderPreviewToggle"
                        AutomationProperties.Name="通知显示消息预览"
                        Toggled="ReminderPreviewToggle_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="随 Windows 登录启动" Description="登录后在后台开始捕获，不主动弹出窗口。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        AutomationProperties.Name="随 Windows 登录启动"
                        Toggled="StartupToggle_Toggled" />
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="外观" />
                <controls:SettingsCard Header="界面字号" Description="同时调整文字、行高与控件间距，并继续遵循 Windows 文字缩放。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8D2;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="FontScaleComboBox"
                        AutomationProperties.Name="界面字号"
                        SelectionChanged="FontScaleComboBox_SelectionChanged" />
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="窗口置顶" />
                <controls:SettingsCard Header="启用窗口置顶">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE718;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Style="{StaticResource DingSecondaryTextStyle}"
                                Text="按 Ctrl + Win + T 置顶当前窗口，再按一次取消。置顶窗口显示描边，不播放音效。" />
                            <TextBlock
                                x:Name="TopmostStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource DingAccentTextBrush}"
                                Style="{StaticResource DingSecondaryTextStyle}" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <ToggleSwitch
                        x:Name="AlwaysOnTopToggle"
                        AutomationProperties.Name="启用窗口置顶"
                        Toggled="AlwaysOnTopToggle_Toggled" />
                </controls:SettingsCard>
                <InfoBar
                    x:Name="TopmostInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Title="窗口置顶需要处理"
                    Visibility="Collapsed" />
                <controls:SettingsCard Header="退出时取消置顶" Description="正常退出 DingLater 时，取消本次由它设置的置顶。关闭上方开关会立即取消这些置顶。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="RestoreTopmostToggle"
                        AutomationProperties.Name="退出时取消置顶"
                        Toggled="RestoreTopmostToggle_Toggled" />
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="存储与隐私" />
                <controls:SettingsCard Header="消息留存天数" Description="到期后自动删除本地消息并取消对应提醒，可设置 1–365 天。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="RetentionNumberBox"
                        Width="160"
                        AutomationProperties.Name="消息留存天数"
                        FontFamily="{StaticResource DingTextFontFamily}"
                        FontSize="{ThemeResource DingBodyFontSize}"
                        Maximum="365"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="RetentionNumberBox_ValueChanged" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="删除全部本地消息" Description="永久删除消息、处理状态和稍后提醒，不影响钉钉中的消息。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74D;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        AutomationProperties.Name="删除全部本地消息"
                        Click="DeleteAllButton_Click"
                        Style="{StaticResource DingQuietButtonStyle}">
                        <TextBlock Foreground="{ThemeResource DingDangerBrush}" Text="删除全部…" />
                    </Button>
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="软件更新" />
                <controls:SettingsCard x:Name="UpdateCard">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon>
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/DingLaterMark.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Name="CurrentVersionText" Style="{StaticResource DingBodyStrongTextStyle}" />
                    </controls:SettingsCard.Header>
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="UpdateStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource DingSecondaryTextStyle}" />
                            <TextBlock x:Name="LastUpdateCheckText" Style="{StaticResource DingCaptionTextStyle}" />
                            <ProgressBar
                                x:Name="UpdateProgressBar"
                                Margin="0,6,0,2"
                                AutomationProperties.Name="更新下载进度"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <StackPanel
                                Margin="-12,0,0,0"
                                Orientation="Horizontal"
                                Spacing="4">
                                <HyperlinkButton x:Name="ReleaseNotesLink" Content="查看版本说明" Visibility="Collapsed" />
                                <HyperlinkButton
                                    x:Name="SkipUpdateButton"
                                    Click="SkipUpdateButton_Click"
                                    Content="跳过此版本"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="CheckUpdateButton"
                            Click="CheckUpdateButton_Click"
                            Content="检查更新"
                            Style="{StaticResource DingQuietButtonStyle}" />
                        <Button
                            x:Name="DownloadUpdateButton"
                            Click="DownloadUpdateButton_Click"
                            Content="下载更新"
                            Style="{StaticResource DingPrimaryButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="InstallUpdateButton"
                            Click="InstallUpdateButton_Click"
                            Content="重启并更新…"
                            Style="{StaticResource DingPrimaryButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="CancelUpdateButton"
                            Click="CancelUpdateButton_Click"
                            Content="取消下载"
                            Style="{StaticResource DingQuietButtonStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="自动检查更新" Description="运行期间每 6 小时检查 GitHub 正式版本；不会自动下载或重启。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE895;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AutoUpdateToggle"
                        AutomationProperties.Name="每 6 小时自动检查更新"
                        Toggled="AutoUpdateToggle_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="更新下载目录">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                        <TextBlock
                            x:Name="DownloadDirectoryText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource DingSecondaryTextStyle}" />
                    </controls:SettingsCard.Description>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ChooseDownloadDirectoryButton"
                            Click="ChooseDownloadDirectoryButton_Click"
                            Content="选择文件夹…"
                            Style="{StaticResource DingQuietButtonStyle}" />
                        <Button
                            x:Name="ResetDownloadDirectoryButton"
                            Click="ResetDownloadDirectoryButton_Click"
                            Content="恢复默认"
                            Style="{StaticResource DingQuietButtonStyle}" />
                    </StackPanel>
                </controls:SettingsCard>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource DingSettingsGroupHeaderStyle}"
                    Text="诊断" />
                <controls:SettingsExpander
                    Description="用于排查捕获来源，不包含消息内容"
                    Header="捕获来源"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <ItemsControl ItemsSource="{Binding HealthSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureHealthViewModel">
                                        <StackPanel Margin="0,4" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource DingBodyStrongTextStyle}" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DingSecondaryTextStyle}"
                                                    Text="{x:Bind State}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource DingSecondaryTextStyle}" Text="{x:Bind Detail}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
                <controls:SettingsCard Header="诊断信息" Description="复制运行状态与错误代码，不含消息内容。">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8C8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <Button
                        x:Name="CopyDiagnosticsButton"
                        AutomationProperties.Name="复制诊断信息"
                        Click="CopyDiagnosticsButton_Click"
                        Style="{StaticResource DingQuietButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="CopyDiagnosticsIcon"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Glyph="&#xE8C8;" />
                            <TextBlock
                                x:Name="CopyDiagnosticsLabel"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Text="复制" />
                        </StackPanel>
                    </Button>
                </controls:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
